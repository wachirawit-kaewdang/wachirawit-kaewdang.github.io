# Auto detect text files and perform LF normalization
* text=auto

# Keep binary assets byte-exact (the resume PDF is ASCII85-encoded and looks like text)
*.pdf binary
*.png binary
*.webp binary
# The frozen notebook is checked by its git hash, so it must stay byte for byte as committed
*.ipynb binary
# Hook scripts run under sh, which reads a CR as part of the command, so they keep LF endings.
.githooks/* text eol=lf
