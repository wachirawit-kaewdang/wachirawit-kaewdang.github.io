{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "resume": "node scripts/build-resume.mjs",
    "check": "node scripts/check.mjs",
    "check:phone": "node scripts/check-phone.mjs",
    "prepare": "node -e \"try { require('child_process').execFileSync('git', ['config', 'core.hooksPath', '.githooks']) } catch { console.warn('! Could not switch on the git hooks. Run: git config core.hooksPath .githooks') }\"",
    "render-check": "node scripts/render-check.mjs",
    "history-check": "node scripts/history-check.mjs",
    "test": "node --test scripts/metrics.test.mjs scripts/phone.test.mjs scripts/hooks.test.mjs",
    "test:extractor": "node scripts/python.mjs scripts/test_extract_metrics.py",
    "verify:notebook": "node scripts/verify-notebook.mjs",
    "verify": "npm run lint && npm test && npm run test:extractor && npm run check && npm run verify:notebook && npm run build && npm run render-check && npm run history-check",
    "help": "node -e \"process.stdout.write(require('fs').readFileSync('WORKFLOWS.txt','utf8'))\""
  },
  "dependencies": {
    "@fontsource/stix-two-text": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
